# USER ACTION REQUIRED: the Measurement ID from DigitalFace's own GA4 web stream.
# Vercel: set for Production only; build reads VERCEL_ENV automatically.
VITE_GA4_MEASUREMENT_ID=
# Optional public Meta Pixel/Dataset ID. Leave blank to disable Meta tracking.
VITE_META_PIXEL_ID=
# Optional Meta Conversions API. Set the flag to true for Vercel Production.
VITE_META_CAPI_ENABLED=
# Server-only Vercel Production secret from the same Meta dataset.
META_CAPI_ACCESS_TOKEN=
# Temporary test code from Events Manager; clear it after testing.
META_CAPI_TEST_EVENT_CODE=
# For an explicitly configured non-Vercel production build only:
# DF_DEPLOY_ENV=production
# Server-side form destination; configure through your hosting secret store.
N8N_LEAD_WEBHOOK_URL=

# Separate event registration receiver; HTTPS; requires persisted receipt and atomic identity uniqueness.
EVENT_REGISTRATION_WEBHOOK_URL=
# Server-only authentication for the dedicated n8n event webhook.
EVENT_REGISTRATION_WEBHOOK_KEY=
