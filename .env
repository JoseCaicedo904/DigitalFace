# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=459119b44adb489bbd8ab3126c18e40b
PING_MESSAGE="ping pong"

# Server-side only. The DigitalFace lead-intake endpoint that /api/lead forwards
# submissions to. Never prefixed with VITE_ so it can never reach the browser.
# Set the real value in the hosting provider's environment settings; while it is
# empty the form fails honestly instead of silently dropping leads.
N8N_LEAD_WEBHOOK_URL=
